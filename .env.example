# Ambiente de Execução (development, production, test)
NODE_ENV=development

# Configurações do Gateway
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Segredo Criptográfico JWT (mínimo 32 caracteres recomendado para produção)
JWT_SECRET=super-secret-gateway-master-key-32ch!
JWT_ISSUER=fastify-api-gateway

# Redis para Rate Limiting Distribuído (Sliding Window Atômico)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=gateway:ratelimit:

# Endpoints dos Serviços Upstream
USERS_SERVICE_URL=http://127.0.0.1:3001
ORDERS_SERVICE_URL=http://127.0.0.1:3002
BILLING_SERVICE_URL=http://127.0.0.1:3003

# Timeout Padrão para Chamadas aos Upstreams (ms)
DEFAULT_PROXY_TIMEOUT_MS=15000
